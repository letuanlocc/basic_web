PORT=3000
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chỉ dùng ở server, KHÔNG commit, KHÔNG đưa lên client
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Google Calendar (OAuth) – tạo ở Google Cloud Console > Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Chỉ dùng ở server, KHÔNG commit, KHÔNG đưa lên client
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Theo dõi & ghi log (tùy chọn, bỏ trống thì tắt)
# Sentry: lỗi server (project Node.js) và lỗi trình duyệt (project Browser JavaScript)
SENTRY_DSN=
SENTRY_BROWSER_DSN=
SENTRY_ENVIRONMENT=development
# Đặt 1 để bật /api/debug-error (ném lỗi thử nghiệm kiểm tra Sentry); tắt khi chạy thật
SENTRY_TEST=
# Google Analytics 4: Measurement ID dạng G-XXXXXXXXXX
GA_MEASUREMENT_ID=
# Đặt 1 khi chạy sau proxy (Vercel…) để nhận đúng IP và HTTPS
TRUST_PROXY=

# Mật khẩu chung cho 6 tài khoản demo khi chạy node scripts/seed-demo.js --apply (từ 12 ký tự)
DEMO_SEED_PASSWORD=
