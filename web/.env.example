# API Express mà mọi /api/* được chuyển tiếp sang (xem next.config.mjs)
API_URL=http://localhost:3000

# Đọc tin tuyển công khai ngay trên máy chủ Next.js (/jobs, /jobs/[id]).
# Dùng publishable key (role anon, có RLS) giống backend; KHÔNG dùng secret key ở đây.
# Bỏ trống thì máy chủ Next.js đọc qua API_URL như cũ.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
