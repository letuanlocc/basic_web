{
  "name": "basic_web",
  "version": "1.0.0",
  "description": "Web app: Node.js + Express + Supabase",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"tests/**/*.test.js\" \"scripts/**/*.test.js\"",
    "build:css": "tailwindcss -i ./tailwind/input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./tailwind/input.css -o ./public/css/tailwind.css --watch"
  },
  "dependencies": {
    "@sentry/node": "^11.14.0",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/functions": "^3.11.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "googleapis": "^190.0.0",
    "helmet": "^8.3.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
